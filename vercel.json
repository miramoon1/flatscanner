{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/data.py": {
      "maxDuration": 60,
      "includeFiles": "scanner/**"
    },
    "api/jumeirah.py": {
      "maxDuration": 60,
      "includeFiles": "scanner/**"
    }
  },
  "cleanUrls": true,
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }]
    }
  ]
}
